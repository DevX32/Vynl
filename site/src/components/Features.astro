---
const groups = [
  {
    label: 'Player',
    items: [
      { title: 'Built-in player', text: 'Play, pause, seek and volume without leaving the window.' },
      { title: 'Queue management', text: 'Reorder, remove and shuffle the upcoming queue.' },
      { title: 'Fullscreen mode', text: 'A distraction-free player view for the big screen.' },
      { title: 'Persistent state', text: 'Now Playing survives restarts, so you pick up where you left off.' }
    ]
  },
  {
    label: 'Library',
    items: [
      { title: 'Incremental scanning', text: 'Library scans pick up changes without rescanning everything.' },
      { title: 'Playlists', text: 'Create, rename and delete playlists, then reorder tracks inside them.' },
      { title: 'Cover art', text: 'Embedded artwork and metadata, with custom playlist covers.' }
    ]
  },
  {
    label: 'Lyrics',
    items: [
      { title: 'Synced lyrics', text: 'LRC and plain text, fetched from LRCLIB and lyrics.ovh.' },
      { title: 'Embed them', text: 'Write lyrics straight into the audio file for portable players.' },
      { title: 'In-player overlay', text: 'Scrollable lyrics that follow along inside the player.' }
    ]
  },
  {
    label: 'Integrations',
    items: [
      { title: 'Discord Rich Presence', text: 'Show what you are listening to straight in your profile.' },
      { title: 'System tray', text: 'Quick controls from the tray, with a minimised player.' },
      { title: 'Auto-updater', text: 'Stay current with in-app update checks.' },
      { title: 'Theming & i18n', text: 'Accent colors you choose, and a translated interface.' }
    ]
  }
]
---

<section class="section" id="features">
  <div class="container">
    <div class="reveal">
      <span class="section-index">01 — Capabilities</span>
      <h2 class="section-title">Everything you need, <em>nothing you don’t.</em></h2>
      <p class="section-sub">
        A focused feature set — only the things a music player does well, with no dashboard to configure.
      </p>
    </div>

    <div class="groups">
      {groups.map((group, index) => (
        <div class="group reveal" style={`transition-delay:${index * 70}ms`}>
          <h3 class="group-label">{group.label}</h3>
          <ul class="rows">
            {group.items.map((item) => (
              <li>
                <span class="row-title">{item.title}</span>
                <span class="leader" aria-hidden="true"></span>
                <span class="row-text">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 64px;
    margin-top: 56px;
  }

  .group-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    font-weight: 480;
    margin-bottom: 6px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .row-title {
    font-weight: 550;
    font-size: 15px;
    white-space: nowrap;
  }

  .leader {
    flex: 1;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-4px);
  }

  .row-text {
    color: var(--ink-soft);
    font-size: 13.5px;
    text-align: right;
    max-width: 46%;
  }

  @media (max-width: 900px) {
    .groups {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .rows li {
      flex-wrap: wrap;
      gap: 4px 14px;
    }

    .leader {
      display: none;
    }

    .row-text {
      max-width: none;
      text-align: left;
    }
  }
</style>
