---
import Icon from './Icon.astro'
import { base } from '../lib/base'
import { getLatestRelease } from '../lib/releases'
import { getAppVersion, RELEASES_URL, REPO_URL } from '../lib/repo'

const release = await getLatestRelease()

const version = release?.version ?? getAppVersion()

const windowsUrl = release?.windows?.url ?? RELEASES_URL
const linuxUrl =
  release?.linux.find((asset) => asset.format === 'AppImage')?.url ??
  release?.linux[0]?.url ??
  RELEASES_URL
const defaultUrl = release ? windowsUrl : RELEASES_URL

const highlights = [
  'Gapless player with queue',
  'Synced lyrics',
  'Extensible plugins',
  'No account, no cloud'
]
---

<section class="hero">
  <div class="container">

    <h1 class="reveal">
      Music, kept<br />
      <em>quietly <span class="grad">minimal.</span></em>
    </h1>

    <div class="hero-grid">
      <p class="lede reveal">
        A lightweight player for your own files library, playlists and synced
        lyrics inside a native window that gets out of the way once the music
        starts.
      </p>

      <div class="hero-side reveal">
        <ul class="highlights">
          {highlights.map((label) => <li>{label}</li>)}
        </ul>
        <div class="btn-row">
          <a
            class="btn btn--primary btn--lg"
            href={defaultUrl}
            data-download
            data-windows={windowsUrl}
            data-linux={linuxUrl}
          >
            <Icon name="download" size={17} />
            <span data-download-label>Download</span>
          </a>
          <a class="btn btn--ghost btn--lg" href={REPO_URL} target="_blank" rel="noopener">
            <Icon name="github" size={17} />
            View source
          </a>
        </div>
      </div>
    </div>

    <figure class="plate reveal">
      <div class="plate-frame">
        <img src={`${base}screenshots/home.png`} alt="Vynl home screen" width="1596" height="896" loading="eager" />
      </div>
      <figcaption>
        <span>Fig. 01 — Home</span>
        <span>Recently played, pinned, up next.</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLAnchorElement>('[data-download]')

  if (button) {
    const ua = navigator.userAgent
    const platform = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? ''
    const label = button.querySelector<HTMLElement>('[data-download-label]')

    const set = (url: string | undefined, text: string) => {
      if (!url) return
      button.href = url
      if (label) label.textContent = text
    }

    if (/win/i.test(platform) || /windows/i.test(ua)) {
      set(button.dataset.windows, 'Download for Windows')
    } else if (/linux|x11/i.test(ua) && !/android/i.test(ua)) {
      set(button.dataset.linux, 'Download for Linux')
    }
  }
</script>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 80px;
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-strong);
  }

  .masthead-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .masthead-brand img {
    border-radius: var(--radius);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .mono.dot {
    color: var(--signal);
    font-size: 8px;
  }

  h1 {
    margin-top: 72px;
    font-size: clamp(52px, 9vw, 116px);
    font-weight: 430;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  h1 em {
    font-style: italic;
    font-weight: 380;
    color: var(--faint);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 80px;
    align-items: start;
  }

  .lede {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .highlights {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .highlights li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .plate {
    margin: 340px 0 0;
  }

  .plate-frame {
    border: 0;
    padding: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .plate-frame img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 36px;
      padding-bottom: 56px;
    }

    figcaption {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
