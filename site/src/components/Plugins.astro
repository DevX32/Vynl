---
import Icon from './Icon.astro'
import { STORE_URL } from '../lib/repo'

const capabilities = [
  'A JavaScript runtime with onLoad / onEnable / onDisable / onUnload hooks',
  'Providers for lyrics, artist info and collection resolution',
  'Settings sections, Home sections and whole pages contributed by plugins',
  'Player observation and playback control, gated behind a permission',
  'One-click installs and updates from the built-in plugin store',
  'A dev folder for live reload, or sideload any .zip'
]

const sample = `// listen-along/index.js
export default {
  id: 'listen-along',
  name: 'Listen Along',
  version: '1.0.0',

  permissions: ['player'],

  async onLoad(api) {
    this.api = api
  },

  async onEnable() {
    // host a session, share the code, friends follow along
    this.session = await this.api.sessions.create({
      control: ['play', 'pause', 'seek']
    })
  },

  onDisable() {
    this.session?.close()
  }
}`
---

<section class="section" id="plugins">
  <div class="container">
    <div class="reveal">
      <span class="section-index">03 — Plugins</span>
      <h2 class="section-title">Pluggable <em>by design.</em></h2>
      <p class="section-sub">
        Vynl ships a real plugin runtime, not an extension bolted on afterwards. Write JavaScript,
        get a whole new capability.
      </p>
    </div>

    <div class="split">
      <div class="split-copy reveal">
        <ul class="caps">
          {capabilities.map((cap) => (
            <li>
              <span class="tick"><Icon name="check" size={12} /></span>
              {cap}
            </li>
          ))}
        </ul>

        <div class="btn-row">
          <a class="btn btn--primary" href={STORE_URL} target="_blank" rel="noopener">
            <Icon name="box" size={16} />
            Browse the plugin store
            <Icon name="external-link" size={14} />
          </a>
        </div>
      </div>

      <div class="split-code reveal" style="transition-delay:90ms">
        <div class="code-bar">
          <em>plugin.js</em>
        </div>
        <pre><code>{sample}</code></pre>
      </div>
    </div>

    <article class="spotlight reveal">
      <div class="spotlight-body">
        <span class="kicker">Store plugin</span>
        <h3>Listen Along</h3>
        <p>
          Host a listening session, share a short code, and let friends follow your playback in
          real time, with synced position, queue and controls. It ships as a plugin, which is the
          clearest proof that the runtime is genuinely open.
        </p>
      </div>
      <a
        class="btn btn--ghost"
        href={`${STORE_URL}/tree/main/plugins/listen-along`}
        target="_blank"
        rel="noopener"
      >
        <Icon name="github" size={16} />
        View the source
      </a>
    </article>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
    margin-top: 56px;
  }

  .caps {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .caps li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.5;
  }

  .tick {
    display: inline-grid;
    place-items: center;
    color: var(--signal);
    flex-shrink: 0;
  }

  .split-code {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0a0a0c;
    color: var(--ink);
  }

  .code-bar {
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line-strong);
  }

  .code-bar em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 242, 234, 0.55);
  }

  .split-code pre {
    margin: 0;
    padding: 20px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.8px;
    line-height: 1.75;
    color: rgba(245, 242, 234, 0.85);
    tab-size: 2;
  }

  .spotlight {
    margin-top: 28px;
    padding: 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .spotlight h3 {
    font-size: 26px;
    margin-top: 8px;
  }

  .spotlight p {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 14.5px;
    max-width: 72ch;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 720px) {
    .spotlight {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
