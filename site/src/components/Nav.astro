---
import { base } from '../lib/base'
import { REPO_URL } from '../lib/repo'
---

<div class="strip">
  <div class="container strip-inner">
    <a class="strip-logo" href={base} aria-label="Vynl home">
      <img src={`${base}app-icon.png`} alt="" width="18" height="18" />
      <span>Vynl</span>
    </a>
    <span class="strip-mid">A quiet place for your music files</span>
    <a href={REPO_URL} target="_blank" rel="noopener">Open source</a>
  </div>
</div>

<style>
  .strip {
    background: #0a0a0c;
    border-bottom: 1px solid var(--line);
  }

  .strip-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .strip a {
    color: var(--signal);
  }

  .strip-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .strip-logo img {
    border-radius: var(--radius);
    display: block;
  }

  @media (max-width: 760px) {
    .strip-mid {
      display: none;
    }
  }
</style>
