---
import { base } from '../lib/base'

const shots = [
  { file: 'home', title: 'Home', text: 'Recently played, pinned and your next listens in one place.' },
  { file: 'now-playing', title: 'Now Playing', text: 'Fullscreen player with queue and artwork front and center.' },
  { file: 'library', title: 'Library', text: 'Your whole collection, searchable and sortable.' },
  { file: 'lyrics', title: 'Synced lyrics', text: 'Word-by-word lyrics that scroll with the track.' },
  { file: 'playlist', title: 'Playlists', text: 'Build, reorder and re-art your own playlists.' },
  { file: 'settings', title: 'Settings', text: 'Theme, accent color, integrations and plugin options.' }
]
---

<section class="section" id="screenshots">
  <div class="container">
    <div class="reveal head">
      <span class="section-index">02 — Showcase</span>
      <h2 class="section-title">Take a <em>look around.</em></h2>
      <p class="section-sub">{shots.length} screens, one consistent dark interface.</p>
    </div>

    <div class="showcase reveal" data-showcase>
      <div class="stage">
        {shots.map((shot, index) => (
          <figure class={`slide${index === 0 ? ' is-active' : ''}`} data-slide aria-hidden={index === 0 ? 'false' : 'true'}>
            <button
              class="slide-btn"
              type="button"
              data-lightbox
              data-src={`${base}screenshots/${shot.file}.png`}
              data-title={shot.title}
              aria-label={`Open ${shot.title} screenshot`}
              tabindex={index === 0 ? 0 : -1}
            >
              <img
                src={`${base}screenshots/${shot.file}.png`}
                alt={`${shot.title} screen in Vynl`}
                width="1596"
                height="896"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </button>
            <figcaption>
              <span class="mono-idx">{String(index + 1).padStart(2, '0')} / {String(shots.length).padStart(2, '0')}</span>
              <strong>{shot.title}</strong>
              <span class="txt">{shot.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="controls">
        <button class="arrow" type="button" data-prev aria-label="Previous screenshot">←</button>
        <div class="dots">
          {shots.map((shot, index) => (
            <button
              class={`dot${index === 0 ? ' is-active' : ''}`}
              type="button"
              data-dot={index}
              aria-label={`Go to ${shot.title}`}
            ></button>
          ))}
        </div>
        <button class="arrow" type="button" data-next aria-label="Next screenshot">→</button>
      </div>
    </div>
  </div>
</section>

<div class="lightbox" data-lightbox-root hidden>
  <button class="lightbox-close" type="button" aria-label="Close screenshot" data-lightbox-close>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
  <figure>
    <img data-lightbox-image alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</div>

<style>
  .head {
    display: grid;
    gap: 0;
    margin-bottom: 48px;
  }

  .stage {
    display: grid;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
  }

  .slide {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .slide-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .slide img {
    width: 100%;
    height: auto;
    display: block;
  }

  .slide figcaption {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 18px;
    border-top: 1px solid var(--line);
  }

  .slide figcaption .mono-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--signal);
  }

  .slide figcaption strong {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .slide figcaption .txt {
    color: var(--ink-soft);
    font-size: 13px;
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 640px) {
    .slide figcaption .txt {
      display: none;
    }
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
  }

  .arrow {
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .arrow:hover {
      background: rgba(240, 240, 236, 0.05);
    }
  }

  .dots {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 22px;
    height: 3px;
    border: 0;
    padding: 0;
    border-radius: 2px;
    background: var(--line-strong);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .dot.is-active {
    background: var(--signal);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 32px;
    padding-top: calc(32px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    background: rgba(6, 6, 8, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overscroll-behavior: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox figure {
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox.open figure {
    opacity: 1;
    transform: none;
  }

  .lightbox :global(figure) {
    margin: 0;
    max-width: min(1200px, 100%);
  }

  .lightbox :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
  }

  .lightbox :global(figcaption) {
    margin-top: 14px;
    text-align: center;
    color: rgba(245, 242, 234, 0.65);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    transform: rotate(45deg);
    background: rgba(245, 242, 234, 0.08);
    border: 1px solid rgba(245, 242, 234, 0.25);
    color: #f0f0ec;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .lightbox-close svg {
    transform: rotate(-45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .lightbox-close:hover {
      background: rgba(185, 167, 255, 0.18);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lightbox-root]')
  const image = document.querySelector<HTMLImageElement>('[data-lightbox-image]')
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]')
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]')
  let lastFocused: HTMLElement | null = null

  const open = (trigger: HTMLElement) => {
    if (!root || !image || !caption) return
    const src = trigger.dataset.src
    if (!src) return
    lastFocused = document.activeElement as HTMLElement
    image.src = src
    image.alt = trigger.querySelector('img')?.alt ?? ''
    caption.textContent = trigger.dataset.title ?? ''
    root.hidden = false
    void root.offsetWidth
    root.classList.add('open')
    document.body.style.overflow = 'hidden'
    closeBtn?.focus()
  }

  const close = () => {
    if (!root) return
    root.classList.remove('open')
    setTimeout(() => {
      root.hidden = true
      image?.removeAttribute('src')
    }, 350)
    document.body.style.overflow = ''
    lastFocused?.focus()
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
    trigger.addEventListener('click', () => open(trigger))
  })

  closeBtn?.addEventListener('click', close)

  root?.addEventListener('click', (event) => {
    if (event.target === root) close()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root && !root.hidden) close()
  })

  const slideshow = document.querySelector<HTMLElement>('[data-showcase]')
  if (slideshow) {
    const slides = Array.from(slideshow.querySelectorAll<HTMLElement>('[data-slide]'))
    const dots = Array.from(slideshow.querySelectorAll<HTMLButtonElement>('[data-dot]'))
    let current = 0
    let timer: ReturnType<typeof setInterval> | null = null

    const goTo = (index: number) => {
      current = (index + slides.length) % slides.length
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current)
        slide.setAttribute('aria-hidden', i === current ? 'false' : 'true')
        const btn = slide.querySelector<HTMLButtonElement>('button')
        if (btn) btn.tabIndex = i === current ? 0 : -1
      })
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current))
    }

    const start = () => {
      stop()
      timer = setInterval(() => goTo(current + 1), 5000)
    }

    const stop = () => {
      if (timer) clearInterval(timer)
      timer = null
    }

    slideshow.querySelector('[data-prev]')?.addEventListener('click', () => {
      goTo(current - 1)
      start()
    })
    slideshow.querySelector('[data-next]')?.addEventListener('click', () => {
      goTo(current + 1)
      start()
    })
    dots.forEach((dot, i) => dot.addEventListener('click', () => {
      goTo(i)
      start()
    }))

    slideshow.addEventListener('mouseenter', stop)
    slideshow.addEventListener('mouseleave', start)
    start()
  }
</script>
