---
import Icon from './Icon.astro'
import { base } from '../lib/base'

const shots = [
  { file: 'home', title: 'Home', text: 'Recently played, pinned and your next listens in one place.' },
  { file: 'now-playing', title: 'Now Playing', text: 'Fullscreen player with queue and artwork front and center.' },
  { file: 'library', title: 'Library', text: 'Your whole collection, searchable and sortable.' },
  { file: 'lyrics', title: 'Synced lyrics', text: 'Word-by-word lyrics that scroll with the track.' },
  { file: 'playlist', title: 'Playlists', text: 'Build, reorder and re-art your own playlists.' },
  { file: 'settings', title: 'Settings', text: 'Theme, accent color, integrations and plugin options.' }
]
---

<section class="section" id="screenshots">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">Showcase</span>
      <h2 class="section-title">Take a look around</h2>
      <p class="section-sub">{shots.length} screens, one consistent dark interface.</p>
    </div>

    <div class="gallery">
      {shots.map((shot, index) => (
        <button
          class="shot reveal"
          type="button"
          style={`transition-delay:${Math.min(index, 6) * 60}ms`}
          data-lightbox
          data-src={`${base}screenshots/${shot.file}.png`}
          data-title={shot.title}
          aria-label={`Open ${shot.title} screenshot`}
        >
          <img
            src={`${base}screenshots/${shot.file}.png`}
            alt={`${shot.title} screen in Vynl`}
            width="1596"
            height="896"
            loading="lazy"
            decoding="async"
          />
          <span class="caption">
            <strong>{shot.title}</strong>
            <span>{shot.text}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<div class="lightbox" data-lightbox-root hidden>
  <button class="lightbox-close" type="button" aria-label="Close screenshot" data-lightbox-close>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
  <figure>
    <img data-lightbox-image alt="" />
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }

  .shot {
    position: relative;
    display: block;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
    text-align: left;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover {
      border-color: rgba(168, 148, 232, 0.42);
      transform: translateY(-3px);
    }
  }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  .caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 3px;
    padding: 34px 18px 16px;
    text-align: left;
    background: linear-gradient(to top, rgba(10, 10, 12, 0.94) 20%, transparent);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .shot:focus-visible .caption {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover .caption {
      opacity: 1;
      transform: none;
    }
  }

  .caption strong {
    font-size: 15px;
    font-weight: 600;
  }

  .caption span {
    font-size: 13.5px;
    color: var(--dim);
  }

  @media (hover: none) {
    .caption {
      opacity: 1;
      transform: none;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 32px;
    /* The close button sits under the notch and the image under the home
       indicator without these. */
    padding-top: calc(32px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    background: rgba(6, 6, 8, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    /* Stop a flick past the image from chaining out to the page behind. */
    overscroll-behavior: contain;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox :global(figure) {
    margin: 0;
    max-width: min(1200px, 100%);
  }

  .lightbox :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg);
  }

  .lightbox :global(figcaption) {
    margin-top: 14px;
    text-align: center;
    color: var(--dim);
    font-size: 14px;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .lightbox-close:hover {
      background: rgba(255, 255, 255, 0.14);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lightbox-root]')
  const image = document.querySelector<HTMLImageElement>('[data-lightbox-image]')
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]')
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]')
  let lastFocused: HTMLElement | null = null

  const open = (trigger: HTMLElement) => {
    if (!root || !image || !caption) return
    const src = trigger.dataset.src
    if (!src) return
    lastFocused = document.activeElement as HTMLElement
    image.src = src
    image.alt = trigger.querySelector('img')?.alt ?? ''
    caption.textContent = trigger.dataset.title ?? ''
    root.hidden = false
    document.body.style.overflow = 'hidden'
    closeBtn?.focus()
  }

  const close = () => {
    if (!root) return
    root.hidden = true
    image?.removeAttribute('src')
    document.body.style.overflow = ''
    lastFocused?.focus()
  }

  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach((trigger) => {
    trigger.addEventListener('click', () => open(trigger))
  })

  closeBtn?.addEventListener('click', close)

  root?.addEventListener('click', (event) => {
    if (event.target === root) close()
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root && !root.hidden) close()
  })
</script>
