---
import Icon from './Icon.astro'
import { getLatestRelease, FALLBACK_DOWNLOAD_URL } from '../lib/releases'

const release = await getLatestRelease()
---

<section class="section" id="download">
  <div class="container">
    <div class="reveal">
      <span class="section-index">04 — Download</span>
      <h2 class="section-title">Get <span class="grad">Vynl</span>.</h2>
      <p class="section-sub">Free, open source, AGPL-3.0. No account, no cloud, no tracking.</p>
    </div>

    <div class="platforms">
      <article class="card platform reveal">
        <header>
          <span class="platform-icon"><Icon name="windows" size={19} /></span>
          <div>
            <h3>Windows</h3>
            <p>64-bit · NSIS installer</p>
          </div>
        </header>

        {release?.windows ? (
          <a class="btn btn--primary download-btn" href={release.windows.url}>
            <Icon name="download" size={16} />
            <span class="file">{release.windows.file}</span>
            <span class="size">{release.windows.size}</span>
          </a>
        ) : (
          <a class="btn btn--primary download-btn" href={FALLBACK_DOWNLOAD_URL} target="_blank" rel="noopener">
            <Icon name="download" size={16} />
            Download the installer
          </a>
        )}

        <p class="platform-hint">Windows 10 or newer. SmartScreen may warn on first run.</p>
      </article>

      <article class="card platform reveal" style="transition-delay:80ms">
        <header>
          <span class="platform-icon"><Icon name="terminal" size={19} /></span>
          <div>
            <h3>Linux</h3>
            <p>x86_64 · three package formats</p>
          </div>
        </header>

        <div class="linux-links">
          {release?.linux.length ? (
            release.linux.map((asset) => (
              <a class="pkg" href={asset.url}>
                <span class="pkg-format">{asset.format}</span>
                <span class="pkg-size">{asset.size}</span>
              </a>
            ))
          ) : (
            <a class="pkg" href={FALLBACK_DOWNLOAD_URL} target="_blank" rel="noopener">
              <span class="pkg-format">AppImage</span>
              <span class="pkg-size">.deb · .rpm</span>
            </a>
          )}
        </div>

        <p class="platform-hint">AppImage just runs. The .deb and .rpm register a system package.</p>
      </article>

      <article class="card platform reveal" style="transition-delay:160ms">
        <header>
          <span class="platform-icon"><Icon name="android" size={19} /></span>
          <div>
            <h3>Android</h3>
            <p>Companion app · pairs with your desktop</p>
          </div>
        </header>

        <div class="linux-links">
          {release?.android.length ? (
            release.android.map((asset) => (
              <a class="pkg" href={asset.url}>
                <span class="pkg-format">
                  {asset.recommended && <span class="pkg-tag">Recommended</span>}
                  {asset.abi}
                </span>
                <span class="pkg-size">{asset.size}</span>
              </a>
            ))
          ) : (
            <a class="pkg" href={FALLBACK_DOWNLOAD_URL} target="_blank" rel="noopener">
              <span class="pkg-format">arm64-v8a</span>
              <span class="pkg-size">.apk</span>
            </a>
          )}
        </div>

        <p class="platform-hint">
          Sideload the APK, then pair over your local network with <strong>Settings → Mobile Sync</strong>.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .platform {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .platform header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .platform-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .platform h3 {
    font-size: 21px;
    font-weight: 500;
  }

  .platform header p {
    color: var(--faint);
    font-size: 13px;
    margin-top: 3px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .download-btn {
    justify-content: flex-start;
    padding-inline: 16px;
  }

  .file {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .size {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.7;
  }

  .linux-links {
    display: grid;
    gap: 8px;
  }

  .pkg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 15px;
    border: 1px solid var(--line);
    background: rgba(240, 240, 236, 0.04);
    font-size: 14px;
    transition: border-color 0.15s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .pkg:hover {
      border-color: var(--line-strong);
      background: rgba(240, 240, 236, 0.05);
    }
  }

  .pkg-format {
    font-family: var(--font-mono);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .pkg-tag {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    color: var(--paper);
    background: var(--signal);
  }

  .pkg-size {
    color: var(--faint);
    font-size: 12.5px;
    font-family: var(--font-mono);
  }

  .platform-hint {
    color: var(--faint);
    font-size: 13px;
    margin-top: auto;
    line-height: 1.55;
  }
</style>
