---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { base } from '../lib/base'
import { REPO_URL } from '../lib/repo'

interface Props {
  title: string
  description: string
  image?: string
}

const { title, description, image = 'screenshots/home.png' } = Astro.props

const sitePath = Astro.url.pathname.replace(new RegExp(`^${base.replace(/[/\\^$*+?.()|[\]{}]/g, '\\$&')}`), '') || '/'
const canonical = new URL(sitePath, Astro.site)
const ogImage = new URL(`${base}${image.replace(/^\//, '')}`, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}app-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}app-icon.png`} />
    <meta name="theme-color" content="#0e0e10" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vynl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Vynl',
      description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Windows, Linux',
      url: canonical.origin,
      codeRepository: REPO_URL,
      license: 'https://opensource.org/licenses/AGPL-3.0',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
    })} />
  </head>

  <body>
    <div class="page">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      const targets = document.querySelectorAll('.reveal')
      if ('IntersectionObserver' in window && targets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-visible')
              io.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        )
        targets.forEach((el) => io.observe(el))
      } else {
        targets.forEach((el) => el.classList.add('is-visible'))
      }
    </script>
  </body>
</html>
